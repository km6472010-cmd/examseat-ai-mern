# Copy to .env in this directory (backend/) and adjust as needed.
# Every field here maps directly to src/config.js:settings -- see that file
# for the full list plus in-code documentation of each default.

# MongoDB connection string. Point this at any real MongoDB instance --
# local mongod, Docker, or MongoDB Atlas. If it can't be reached (e.g. in
# a network-restricted sandbox), the app automatically falls back to an
# embedded local JSON datastore so it still runs -- see
# src/db/localStore.js for the full explanation.
MONGODB_URI=mongodb://127.0.0.1:27017/examseat
MONGODB_CONNECT_TIMEOUT_MS=2500

PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DETECTION_BACKEND=heuristic
PERSON_DETECTION_CONFIDENCE_THRESHOLD=0.35
SEAT_MATCH_MAX_DISTANCE_NORM=0.12
CONFIDENCE_REVIEW_THRESHOLD=0.60
CONFIDENCE_HIGH_THRESHOLD=0.80
IDENTITY_MATCH_THRESHOLD=0.75

AUTO_DELETE_EVIDENCE=false
RETENTION_DAYS=30
