# ExamSeat AI -- example environment configuration.
#
# For local development without Docker, copy the relevant variables into
# backend/.env and frontend/.env.local (both directories have their own
# .env.example with the full, directory-specific list). This root file is a
# quick-reference summary of every variable used across the stack, mirrored
# by docker-compose.yml's `environment:` blocks.

# ---- Backend (backend/.env) ------------------------------------------------

# SQLite (default, zero setup) or Postgres, e.g.:
# postgresql+psycopg2://examseat:examseat@localhost:5432/examseat
DATABASE_URL=sqlite:///./data/examseat.db

# Comma-free JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:3000"]

# "opencv" (default, offline, no model download) or "yolo" (requires the
# optional ultralytics package + downloaded weights; falls back to opencv
# automatically if unavailable -- see app/cv/detectors.py).
DETECTION_BACKEND=opencv

# Confidence thresholds (all also editable at runtime from the Settings page).
PERSON_DETECTION_CONFIDENCE_THRESHOLD=0.35
SEAT_MATCH_MAX_DISTANCE_NORM=0.12
CONFIDENCE_REVIEW_THRESHOLD=0.60
CONFIDENCE_HIGH_THRESHOLD=0.80
IDENTITY_MATCH_THRESHOLD=0.75

# Privacy / retention (see README > Privacy Considerations).
AUTO_DELETE_EVIDENCE=false
RETENTION_DAYS=30

# ---- Frontend (frontend/.env.local) ----------------------------------------

NEXT_PUBLIC_API_URL=http://localhost:8000
