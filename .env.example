# ExamSeat AI -- example environment configuration (MERN stack).
#
# For local development, copy the relevant variables into backend/.env and
# frontend/.env (both directories have their own .env.example with the
# full, directory-specific list). This root file is a quick-reference
# summary of every variable used across the stack.

# ---- Backend (backend/.env) ------------------------------------------------

# MongoDB connection string -- local mongod, Docker, or MongoDB Atlas.
# If unreachable, the backend automatically falls back to an embedded
# local JSON datastore so it still runs (see backend/src/db/localStore.js
# and README > MERN Conversion Notes for why/when that happens).
MONGODB_URI=mongodb://127.0.0.1:27017/examseat
MONGODB_CONNECT_TIMEOUT_MS=2500

PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DETECTION_BACKEND=heuristic
PERSON_DETECTION_CONFIDENCE_THRESHOLD=0.35
SEAT_MATCH_MAX_DISTANCE_NORM=0.12
CONFIDENCE_REVIEW_THRESHOLD=0.60
CONFIDENCE_HIGH_THRESHOLD=0.80
IDENTITY_MATCH_THRESHOLD=0.75

AUTO_DELETE_EVIDENCE=false
RETENTION_DAYS=30

# ---- Frontend (frontend/.env) ----------------------------------------------

VITE_API_URL=http://localhost:8000
